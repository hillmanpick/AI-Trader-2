# Copy to deploy/.env on the server. chmod 600 deploy/.env
POSTGRES_PASSWORD=
QUANT_API_TOKEN=
ENVIRONMENT=production
PUBLIC_HOST=124.156.199.59
WEB_HTTPS_PORT=8443
CLAWTRADER_CORS_ORIGINS=https://124.156.199.59:8443
QUANT_DB_PATH=/data/quant-paper.db
QUANT_MODE=paper
QUANT_ENABLED=true
QUANT_LIVE_ENABLED=false
# Display production Binance account and AI advice, without execution or account changes.
QUANT_OBSERVATION_ONLY=true
# Only fill these directly on the server. No withdrawal permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Official public community is read-only. Token is optional for public feeds.
AI4TRADE_ENABLED=true
AI4TRADE_AGENT_ID=22728
AI4TRADE_TOKEN=
AI4TRADE_POLL_SECONDS=60
# AI reviews entry signals only; stops/exits never wait for the model.
# With AI enabled and no key, new entries are withheld.
QUANT_AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
QUANT_AI_ADVICE_SECONDS=900
QUANT_AI_MIN_CONFIDENCE=0.65
QUANT_AI_REVIEW_MAX_AGE_SECONDS=90
QUANT_SYMBOLS=BTCUSDT,ETHUSDT
QUANT_STRATEGY=sma_cross
QUANT_INTERVAL=15m
QUANT_SMA_FAST=10
QUANT_SMA_SLOW=30
QUANT_BOLL_PERIOD=13
QUANT_BOLL_DEVIATION=2
QUANT_ALLOW_SHORT=true
# Notional = order value, NOT margin. Margin approx notional/leverage.
QUANT_LEVERAGE=1
QUANT_ORDER_NOTIONAL_USDT=50
QUANT_MAX_TOTAL_NOTIONAL_USDT=100
QUANT_MAX_POSITIONS=2
QUANT_STOP_LOSS_PCT=0.02
QUANT_TAKE_PROFIT_PCT=0.04
QUANT_MAX_DAILY_LOSS_USDT=20
QUANT_PAPER_BALANCE_USDT=110000
QUANT_PAPER_FEE_RATE=0.0005
QUANT_POLL_SECONDS=10
# Independent virtual simulation; keep real observer switches unchanged.
QUANT_PAPER_ENABLED=false
QUANT_PAPER_DB_PATH=/data/quant-aggressive-paper.db
QUANT_PAPER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,NEARUSDT,XRPUSDT,DOGEUSDT,SUIUSDT,1000PEPEUSDT
QUANT_PAPER_STRATEGY=adaptive
QUANT_PAPER_INTERVAL=1m
QUANT_PAPER_LEVERAGE=100
QUANT_PAPER_MARGIN_USDT=2000
QUANT_PAPER_MAX_MARGIN_USDT=6000
QUANT_PAPER_DYNAMIC_EXITS=true
QUANT_PAPER_DYNAMIC_LEVERAGE=true
QUANT_PAPER_MIN_LEVERAGE=2
QUANT_PAPER_MAX_LEVERAGE=20
QUANT_PAPER_RISK_FRACTION=0.10
QUANT_PAPER_RISK_BUFFER_BPS=10
QUANT_PAPER_DEPTH_PARTICIPATION=0.05
QUANT_PAPER_MAX_SPREAD_BPS=10
QUANT_PAPER_DEPTH_RANGE_BPS=10
QUANT_PAPER_LAB_REQUIRED=true
# After readiness validation, use QUANT_PAPER_STRATEGY=lab_model for numeric inference.
QUANT_LAB_ENABLED=true
QUANT_REDIS_URL=redis://redis:6379/1
QUANT_LAB_DIR=/data/lab
QUANT_LAB_CANDIDATES=12
QUANT_LAB_MIN_VOLUME_USDT=20000000
QUANT_LAB_SAMPLE_SECONDS=5
QUANT_LAB_RETENTION_DAYS=14
QUANT_LAB_RAW_MB_DAY=512
QUANT_LAB_HORIZON_SECONDS=300
QUANT_LAB_MIN_SAMPLES=10000
QUANT_LAB_MIN_DAYS=7
QUANT_LAB_MODEL_MAX_AGE_HOURS=48
QUANT_LAB_AUTO_TRAIN=true
# Individual trade stream for every active USDT perpetual, sharded subscriptions.
QUANT_ALL_MARKET_TRADES=true
QUANT_TRADE_SHARD_SIZE=128
QUANT_EVENT_MAX_GB=6
# Final model: separate validation/test event windows; never trained on either.
QUANT_EVENT_VALIDATION_SECONDS=3600
# Optional read-only market-data key for exact historical individual-trade backfill.
# It is never used for signed requests or order submission.
BINANCE_MARKET_DATA_KEY=
# Cost/target gate starts in shadow; the paper reflector may promote it after
# enough net-of-cost evidence. Keep this explicit override if you need a freeze.
QUANT_PAPER_ENTRY_FILTER=shadow
# Paper-only strategy reflection. It records closed trades and can promote the
# bounded cost filter after enough net-of-cost evidence.
QUANT_PAPER_REFLECTION_ENABLED=true
QUANT_PAPER_REFLECTION_MIN_TRADES=12
QUANT_PAPER_REFLECTION_WINDOW=50
QUANT_PAPER_REFLECTION_INTERVAL_TRADES=10
# Simplified isolated maintenance margin, NOT Binance risk brackets.
QUANT_PAPER_MAINTENANCE_RATE=0.005
QUANT_PAPER_POLL_SECONDS=5
QUANT_PAPER_SLIPPAGE_BPS=3
QUANT_PAPER_BOLL_DEVIATION=1.5
QUANT_PAPER_SMA_FAST=3
QUANT_PAPER_SMA_SLOW=10
# Optional paper-only exploration; does not change real-account observation.
QUANT_PAPER_AI_MIN_CONFIDENCE=0.55
QUANT_PAPER_AI_REVIEW_MAX_AGE_SECONDS=30
QUANT_PAPER_AI_RELAXED=true
# Legacy notional values are ignored when paper margin is set.
QUANT_PAPER_ORDER_NOTIONAL_USDT=200000
QUANT_PAPER_MAX_TOTAL_NOTIONAL_USDT=600000
QUANT_PAPER_MAX_POSITIONS=3
# Fallback distances; dynamic ATR + trailing stops are enabled for new positions.
QUANT_PAPER_STOP_LOSS_PCT=0.0025
QUANT_PAPER_TAKE_PROFIT_PCT=0.005
# Paper mode has no daily loss circuit breaker; legacy paper loss-limit values are ignored.
QUANT_PAPER_BALANCE_USDT=10000
# QQ mailbox -> Settings -> Account -> enable SMTP; use AUTH CODE, not password.
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
QQ_MAIL_TO=
AI_TRADER_API_BACKGROUND_TASKS=false
AI_TRADER_BACKGROUND_TASKS=prices,profit_history
